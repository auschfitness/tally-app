# Tally — variáveis de ambiente (Next.js)
# Copie para .env.local e preencha. Nenhum segredo aqui.
#
# URL e chave PÚBLICA (anon) do Supabase. A anon key é pública por design —
# toda a segurança está no RLS do banco. NUNCA coloque a service_role key aqui
# nem em qualquer variável com prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
