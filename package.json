{
  "name": "tally-web",
  "version": "0.1.0",
  "private": true,
  "description": "Tally — Church OS (Next.js App Router + TypeScript + Supabase)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/features",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "types:db": "echo 'Tipos do banco são gerados pelo orquestrador via MCP Supabase e vivem em src/lib/database.types.ts'"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.2",
    "@supabase/supabase-js": "^2.45.0",
    "chart.js": "^4.4.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
